  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "2"
  DatatypeInheritanceConflictMsg "1"
  ContSampleTimeConflictMsg "1"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "2"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% Circuit\nL = 16.5e-6;% 14.85e-5;    100u % Buck ph"
"ase inductance (H) 1.485e-5; changed to 100uH\nC = 550e-6;        % Output ca"
"pacitance (F) 10e-6; \nRcs = 1.5e-3;     % Current sensing resistor (ohms)\nE"
"SR = 10e-3; %1.5e-3;     % Inductor eSR (ohms)\nR = 2.4;          % Load resi"
"stances (ohms) 2.5; change to 2.4 for 60w\nR1 = 4.8;          % Load resistan"
"ces (ohms) ;for 90w \n\nfSw = 250e3;        % Switching frequency (Hz) 1e6; "
"\nTs = 1/fSw;       % Switching period (s)\ntDead = 50e-9;     % Deadtime (s)"
" 2e-9;\n\n% Current controller\nRi.F = fSw;\nRi.Ts = 1/Ri.F; \nRi.Tp = Ri.Ts/"
"2.0;\n\nRi.Ti = 2/(ESR+Rcs)*Ri.Tp; \nRi.Tn = L/(ESR+Rcs);\n\nRi.Kp = Ri.Tn/Ri"
".Ti;\nRi.Ki = 1/Ri.Ti;\n\n% Voltage controller\nRv.F = Ri.F / 10;\nRv.Ts = 1/"
"Rv.F;     % Sample time\n%Rv.Tp = Rv.Ts/2*10; % Equivalent delay design 1\nRv"
".Tp = Rv.Ts/2; %reducing delay design 2\n\nRv.Ti = 8/C*Rv.Tp*Rv.Tp;\nRv.Tn = "
"4*Rv.Tp;\n\nRv.Kp = Rv.Tn/Rv.Ti;\nRv.Ki = 1/Rv.Ti;"
