      Frame         [-120, -75; 120, 75]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Variable-phase buck converter"
      MaskDescription "This component passes user-defined information to the c"
"ircuit. Wire Selector components are used to vary the number of phases of the"
" Synchronous Buck converter, and the mask image reflects that accordingly. "
      MaskDisplay   "local phase = tonumber(Dialog:get('nPhase'))\n"
"if phase == nil or phase < 1 then\n"
"  phase = 5\n"
"end\n"
"\n"
"local function drawNode (x,y)\n"
"  Icon:patch(Vector{-1, -1, 1, 1}+x, Vector{-1, 1, 1, -1}+y)\n"
"end\n"
"\n"
"local function drawMosfet (x,y)\n"
"  Icon:line({x, x, x-10}, {y+20, y+10, y+10})\n"
"  Icon:line({x, x, x-10}, {y+10, y   , y   })\n"
"  Icon:line({x, x, x-10}, {y-20, y-10, y-10})\n"
"  Icon:line({x-10, x-10}, {y+13, y+7})\n"
"  Icon:line({x-10, x-10}, {y+3, y-3})\n"
"  Icon:line({x-10, x-10}, {y-7, y-13})\n"
"  Icon:line({x-15, x-15}, {y+10, y-10})\n"
"  Icon:line({x-15, x-20}, {y, y})\n"
"  Icon:line({x-4, x-8, x-4}, {y+2, y, y-2})\n"
"end\n"
"\n"
"local function drawDiode (x,y)\n"
"  Icon:line({x, x+10, x+10}, {y-14, y-14, y-6})\n"
"  Icon:line({x+10, x+10, x}, {y+6, y+14, y+14})\n"
"  Icon:line({x+3, x+17}, {y-6, y-6})\n"
"  Icon:line({x+10, x+17, x+3, x+10}, {y-6, y+6, y+6, y-6})\n"
"end\n"
"\n"
"local function drawHalfBridge (x,y,withTopNode)\n"
"  -- top MOSFET \n"
"  drawMosfet(x,y-40)\n"
"\n"
"  -- top diode\n"
"  drawDiode(x,y-40)\n"
"  \n"
"  -- bottom MOSFET\n"
"  drawMosfet(x,y+40)\n"
"\n"
"  -- bottom diode\n"
"  drawDiode(x,y+40)\n"
"  \n"
"  -- wire\n"
"  Icon:line(Vector{0, 0}+x, Vector{-20, 20}+y)\n"
"  \n"
"  -- top node\n"
"  if withTopNode then\n"
"    drawNode(x, -60)\n"
"  end\n"
"  -- bottom node is always drawn\n"
"  drawNode(x, 60)\n"
"end\n"
"\n"
"local function drawInductor (x,y)\n"
"  Icon:arc(-10.5+x, -1.5+y, 3.5, 3.5, 0, 180)\n"
"  Icon:arc(-3.5+x, -1.5+y, 3.5, 3.5, 0, 180)\n"
"  Icon:arc(3.5+x, -1.5+y, 3.5, 3.5, 0, 180)\n"
"  Icon:arc(10.5+x, -1.5+y, 3.5, 3.5, 0, 180)\n"
"  Icon:line(Vector{0, 0}-14+x, Vector{-1.5, 0}+y)\n"
"  Icon:line(Vector{0, 0}-7+x, Vector{-1.5, 0}+y)\n"
"  Icon:line(Vector{0, 0}+x, Vector{-1.5, 0}+y)\n"
"  Icon:line(Vector{0, 0}+7+x, Vector{-1.5, 0}+y)\n"
"  Icon:line(Vector{0, 0}+14+x, Vector{-1.5, 0}+y)\n"
"end\n"
"\n"
"local function drawInductorWithWire (x,y,withRightNode)\n"
"  Icon:line({x, 61}, {y, y})\n"
"  drawInductor(75, y)\n"
"  Icon:line({89, 100}, {y, y})\n"
"  \n"
"  -- left node is always drawn\n"
"  drawNode(x, y)\n"
"  \n"
"  if withRightNode then\n"
"    drawNode(100, y)\n"
"  end\n"
"end\n"
"\n"
"if phase == 1 then\n"
"  Icon:line({-90, -20}, {-60, -60})\n"
"\n"
"  drawHalfBridge(-20, 0)\n"
"  drawInductorWithWire(-20, 0)\n"
"elseif phase == 2 then\n"
"  Icon:line({-90, 0}, {-60, -60})\n"
"\n"
"  drawHalfBridge(-60, 0, true)\n"
"  drawInductorWithWire(-60, -15)\n"
"\n"
"  drawHalfBridge(0, 0)\n"
"  drawInductorWithWire(0, 15)\n"
"elseif phase == 3 then\n"
"  Icon:line({-90, 40}, {-60, -60})\n"
"\n"
"  drawHalfBridge(-80, 0, true)\n"
"  drawInductorWithWire(-80, -15)\n"
"\n"
"  drawHalfBridge(-20, 0, true)\n"
"  drawInductorWithWire(-20, 0, true)\n"
"\n"
"  drawHalfBridge(40, 0)\n"
"  drawInductorWithWire(40, 15)\n"
"else\n"
"  Icon:line({-90, 40}, {-60, -60})\n"
"\n"
"  drawHalfBridge(-80, 0, true)\n"
"  drawInductorWithWire(-80, -15)\n"
"\n"
"  drawHalfBridge(-40, 0, true)\n"
"  drawInductorWithWire(-40, -5, true)\n"
"\n"
"  if phase == 4 then\n"
"    drawHalfBridge(0, 0, true)\n"
"    drawInductorWithWire(0, 5, true)\n"
"  else\n"
"    Icon:circle(-5, -40, .5)\n"
"    Icon:circle(0, -40, .5)\n"
"    Icon:circle(5, -40, .5)\n"
"\n"
"    Icon:circle(-5, 40, .5)\n"
"    Icon:circle(0, 40, .5)\n"
"    Icon:circle(5, 40, .5)\n"
"\n"
"    Icon:circle(55, 0, .5)\n"
"    Icon:circle(55, 5, .5)\n"
"    Icon:circle(55, 10, .5)\n"
"  end\n"
"\n"
"  drawHalfBridge(40, 0)\n"
"  drawInductorWithWire(40, 15)\n"
"end\n"
"\n"
"Icon:line({-90, 85}, {60, 60})\n"
"if phase ~= 1 then\n"
"  Icon:line({100, 100}, {-15, 15})\n"
"  drawNode(100, 0)\n"
"end\n"
"Icon:line({100, 110, 110}, {0, 0, -55})\n"
      MaskDisplayLang "2"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      MaskInit      "% error checking for phase number\n"
"if ~isscalar(nPhase) || ~isreal(nPhase) || nPhase ~= floor(nPhase) || nPhase "
"< 1\n"
"   error('Number of phases must be a positive integer value');\n"
"end\t\n"
"\n"
"if nPhase > 10\n"
"   error('Number of phases must be less than 10.');\n"
"end\t\n"
"\n"
"% error checking for deadtime value\n"
"if tDead > (1/fSw)*0.1\n"
"   error('The deadtime must not exceed 10% of the switching period.');\n"
"elseif isnan(tDead)\n"
"   tDead = 0\n"
"end\n"
"\n"
"% phase-shifting for modulator\n"
"delay = [0:(nPhase-1)]/nPhase/fSw;\n"
      MaskDialogCallback "Dialog:set('tDead', 'Visible', Dialog:get('DTstate')"
" ~= '1')"
      Parameter {
